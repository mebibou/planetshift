{
  "name": "planetshift",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "prerender": "node scripts/prerender.mjs dist",
    "precompress": "node scripts/precompress.mjs dist",
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run --exclude test/model/timing.test.ts && vitest run test/model/timing.test.ts",
    "e2e": "playwright test",
    "fixtures": "node scripts/gen-fixtures.mjs public/fixtures",
    "golden": "UPDATE_GOLDEN=1 vitest run test/golden"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/d3": "^7.4.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "d3": "^7.9.2",
    "katex": "^0.16.47",
    "marked": "^14.1.4",
    "marked-katex-extension": "^5.1.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
